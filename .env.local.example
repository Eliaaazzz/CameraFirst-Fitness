# ===========================================
# AuraFitness Local Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your actual API keys.
# NEVER commit .env.local to version control!
#
# Usage:
#   cp .env.local.example .env.local
#   # Edit .env.local with your actual keys
#   source scripts/setup/set-api-keys.sh
#   ./gradlew bootRun
# ===========================================

# YouTube Data API v3
# Get your key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spoonacular Recipe API
# Get your key at: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Gemini API (Google AI)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) My Private AI Extension
# MY_PRIVATE_AI_URL=https://api.example.com/v1/chat/completions
# MY_PRIVATE_AI_KEY=your_private_ai_key_here
