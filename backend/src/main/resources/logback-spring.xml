<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include Spring Boot defaults for proper conversion words -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console Appender - for stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %5p ${PID:- } --- [%15.15t] %-40.40logger{39} : %m%n%wEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Root logger - only outputs to console -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Spring Boot logging -->
    <logger name="org.springframework" level="INFO" />
    <logger name="org.springframework.web" level="INFO" />
    <logger name="org.springframework.security" level="DEBUG" />
    
    <!-- Application logging -->
    <logger name="com.fitnessapp.backend" level="INFO" />
    
    <!-- Hibernate logging -->
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.hibernate.SQL" level="WARN" />
    
    <!-- Profile-specific configurations -->
    <springProfile name="dev">
        <logger name="com.fitnessapp.backend" level="DEBUG" />
    </springProfile>
    
    <springProfile name="prod">
        <logger name="org.springframework.security" level="WARN" />
        <logger name="com.fitnessapp.backend" level="INFO" />
    </springProfile>
    
    <springProfile name="test">
        <logger name="com.fitnessapp.backend" level="DEBUG" />
        <logger name="org.springframework" level="WARN" />
        <logger name="org.hibernate" level="WARN" />
    </springProfile>
</configuration>
