# ==========================================
# SUPABASE + UPSTASH + CLOUDFLARE R2 Environment Variables
# ==========================================
# Copy this file to .env.supabase and fill in your values
# cp .env.supabase.example .env.supabase

# ==========================================
# Spring Profile
# ==========================================
SPRING_PROFILES_ACTIVE=supabase

# ==========================================
# Supabase PostgreSQL
# ==========================================
# Get from Supabase Dashboard -> Settings -> Database
# Connection string (JDBC): jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_JDBC_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-password

# ==========================================
# Upstash Redis
# ==========================================
# Get from Upstash Console -> Redis -> Details
UPSTASH_REDIS_HOST=xxx.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-upstash-password

# ==========================================
# Cloudflare R2 Storage
# ==========================================
# Get from Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=aurafit
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ==========================================
# API Keys
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
YOUTUBE_API_KEY=your-youtube-api-key
SPOONACULAR_API_KEY=your-spoonacular-api-key
USDA_API_KEY=your-usda-api-key

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id

# ==========================================
# Security
# ==========================================
# At least 256-bit random string
JWT_SECRET=your-secure-jwt-secret-at-least-256-bits-long
API_KEY=your-api-key

# Cookie config (for cross-origin deployment)
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None
APP_COOKIE_DOMAIN=

# ==========================================
# Server
# ==========================================
SERVER_PORT=8080
