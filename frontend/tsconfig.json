{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "resolveJsonModule": true,
    "skipLibCheck": true,
  "types": ["jest", "react-native", "expo", "expo__web-browser"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "index.ts",
    "index.tsx",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "coverage"
  ]
}
