{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "aurafitness",
          "region": "australia-southeast2"
        }
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
