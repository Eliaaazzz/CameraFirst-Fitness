# ==========================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==========================================
#
# 本项目使用分离的环境配置文件:
#   - .env.dev   → 本地开发环境 (docker-compose.yml 使用)
#   - .env.prod  → 生产环境 (docker-compose.prod.yml 使用)
#
# 复制此文件为 .env.dev 或 .env.prod 并填入实际值
# ==========================================

# Spring Profile (dev 或 prod)
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# 本地开发: jdbc:postgresql://fitness-postgres:5432/fitness_mvp
# 生产环境: jdbc:postgresql://postgres:5432/fitness_mvp
SPRING_DATASOURCE_URL=jdbc:postgresql://fitness-postgres:5432/fitness_mvp
SPRING_DATASOURCE_USERNAME=fitnessuser
SPRING_DATASOURCE_PASSWORD=dev_password

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# 本地开发: fitness-redis (Docker 容器)
# 生产环境: AWS ElastiCache 地址
SPRING_DATA_REDIS_HOST=fitness-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL=false

# ==========================================
# API KEYS
# ==========================================
YOUTUBE_API_KEY=your_youtube_api_key_here
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
USDA_API_KEY=your_usda_api_key_here

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here

# AI APIs (Optional)
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_SEED_ENABLED=true
SERVER_PORT=8080
API_KEY=fitness-secret-key-123
APP_API_KEY=fitness-secret-key-123

# ==========================================
# CLOUDFLARE R2 STORAGE
# ==========================================
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=aurafit
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ==========================================
# GOOGLE OAUTH (Frontend - Expo)
# ==========================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id
